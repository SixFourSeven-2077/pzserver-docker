# operational vars, not from the pzwiki settings page
PZ_SERVERNAME=myserver
PUID=1000
PGID=1000
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=change-this-too

# B42 needs ~6GB just to start up, plus ~0.5GB per player, growing further with
# playtime and map exploration. leave 1-2GB of your VPS's RAM for the OS/docker,
# the rest can go here. this is a hard ceiling (-Xmx), not a target: the server
# crashes if it needs more, it doesn't degrade gracefully. 8 below assumes a
# 10GB+ box for 2-4 players, bump it if you provisioned more or have more players
MEMORY_XMX_GB=8
MEMORY_XMS_GB=

# Custom = use every PZ_SBX_* var below, individually
# Apocalypse / Outbreak / Extinction / Rising = use that shipped preset as-is,
# whole file, the PZ_SBX_* vars below are ignored in that case
# SixTunedOutbreak = our own preset, Outbreak as a base, tuned for a 4-player
# group starting right as the outbreak happens, see presets/SixTunedOutbreak.lua
PZ_SANDBOX_PRESET=Custom

# everything below is generated from https://pzwiki.net/wiki/Server_settings
# every var name is PZ_<exact key> for the .ini file, PZ_SBX_<exact key> for
# top level SandboxVars.lua fields, and PZ_SBX_<Table>_<key> for nested ones
# (ZombieLore, ZombieConfig, Map, Basement, MultiplierConfig). change any of
# these, restart the container fresh (delete the volume or the generated
# .ini/.lua files inside it), and it takes effect on next boot. only used
# when PZ_SANDBOX_PRESET=Custom above.

